# Neon Postgres connection string. When Neon is connected to this project via
# Vercel's integration, this is injected automatically in every deployment —
# you only need to set it locally (e.g. `vercel env pull .env` after linking
# the project with `vercel link`, or paste it from the Neon/Vercel dashboard).
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Required to call POST /api/scrape (an HTTP-triggered scrape, for platforms
# whose cron feature can only hit a URL). Leave unset to keep that route
# disabled and only run scrapes via `npm run scrape`.
SCRAPE_SECRET=

# Optional: override the User-Agent the scraper sends. Keep it identifying
# and low-frequency friendly if you change it.
# SCRAPER_USER_AGENT=AutographTrackerBot/0.1 (+https://example.com/contact)
